{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix VirasatX --ignore-scripts",
  "buildCommand": "npm run build --prefix VirasatX",
  "outputDirectory": "VirasatX/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
