{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd VirasatX && (npm ci --ignore-scripts || npm install --ignore-scripts)",
  "buildCommand": "cd VirasatX && npm run build",
  "outputDirectory": "VirasatX/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
